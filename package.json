{
	"name": "forum-backend",
	"version": "1.0.0",
	"description": "",
	"homepage": "https://github.com/Afaks-11/forum-backend#readme",
	"bugs": {
		"url": "https://github.com/Afaks-11/forum-backend/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Afaks-11/forum-backend.git"
	},
	"license": "ISC",
	"author": "Hamman Wadzani Afakirya",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch src/main.ts",
		"start": "node dist/main.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"prepare": "husky",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=./jest.config.cjs --testPathPatterns=tests/unit",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=./jest.config.cjs --watch",
		"test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=./jest.config.cjs --coverage",
		"test:changed": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=./jest.config.cjs --onlyChanged",
		"test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=./jest.config.cjs --ci --maxWorkers=2 --coverage",
		"test:integration:single": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.integration.config.cjs --runInBand",
		"test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.integration.config.cjs --runInBand",
		"test:integration:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.integration.config.cjs --runInBand --watch",
		"test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.e2e.config.cjs --runInBand",
		"db:test:push": "dotenv -e .env.test -- npx prisma db push",
		"test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^9.9.0",
		"@jest/globals": "^30.4.1",
		"@swc/core": "^1.15.46",
		"@swc/jest": "^0.2.39",
		"@testcontainers/postgresql": "^12.0.4",
		"@testcontainers/redis": "^12.0.4",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^8.0.1",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.3",
		"@types/swagger-ui-express": "^4.1.8",
		"dotenv-cli": "^8.0.0",
		"husky": "^9.1.7",
		"jest": "^30.4.1",
		"lint-staged": "^17.0.8",
		"prisma": "^7.8.0",
		"supertest": "^7.2.2",
		"testcontainers": "^12.0.4",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{ts,json}": [
			"biome check --write"
		]
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.5.0",
		"@bull-board/api": "^8.1.2",
		"@bull-board/express": "^8.1.2",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.80.4",
		"cloudinary": "^2.10.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"helmet": "^8.2.0",
		"ioredis": "^5.11.1",
		"jsonwebtoken": "^9.0.3",
		"nodemailer": "^9.0.3",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"prom-client": "^15.1.3",
		"rate-limit-redis": "^5.0.0",
		"socket.io": "^4.8.3",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.4.3"
	}
}
