// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Conventions enforced throughout this schema:
//   - Model fields are camelCase; database columns are snake_case via @map.
//   - Every model maps to a snake_case plural table via @@map.
//   - Timestamps are always createdAt / updatedAt / deletedAt.
//   - Foreign keys are <relation>Id and sit directly above their relation field.
//   - Booleans are is<Predicate>.
//   - Every relation declares explicit onDelete behaviour.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  ADMIN
}

enum MembershipRole {
  MEMBER
  MODERATOR
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum NotificationType {
  NEW_FOLLOWER
  COMMENT
  REPLY
  MOD_ACTION
  COMMUNITY_INVITE
}

enum PostType {
  TEXT
  LINK
}

model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  password String

  role SystemRole @default(USER)

  isEmailVerified         Boolean   @default(false) @map("is_email_verified")
  emailVerifyToken        String?   @unique @map("email_verify_token")
  emailVerifyTokenExpires DateTime? @map("email_verify_token_expires")

  passwordResetToken   String?   @unique @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  loginAttempts Int       @default(0) @map("login_attempts")
  lockUntil     DateTime? @map("lock_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  posts             Post[]
  lockedPosts Post[] @relation("PostLocks")
  ownedCommunities  Community[]     @relation("CommunityOwner")
  memberships       Membership[]
  comments          Comment[]
  votes             Vote[]
  following         Follow[]        @relation("UserFollows")
  followers         Follow[]        @relation("UserFollowedBy")
  blocking          Block[]         @relation("UserBlocks")
  blockedBy         Block[]         @relation("UserBlockedBy")
  notifications     Notification[]  @relation("UserNotifications")
  sentNotifications Notification[]  @relation("NotificationSender")
  savedPosts        SavedPost[]
  savedComments     SavedComment[]
  postReports       Report[]
  commentReports    CommentReport[]

  @@index([deletedAt])
  @@map("users")
}

model Community {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  rules       String? @default("Be respectful.")
  avatarUrl   String? @map("avatar_url")
  bannerUrl   String? @map("banner_url")

  creatorId String @map("creator_id")
  creator   User   @relation("CommunityOwner", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  posts   Post[]
  members Membership[]

  @@index([creatorId])
  @@index([deletedAt])
  @@map("communities")
}

model Membership {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  communityId String   @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  role MembershipRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, communityId])
  @@index([communityId])
  @@map("memberships")
}

model Post {
  id      String   @id @default(uuid())
  title   String
  content String
  type    PostType @default(TEXT)

  isPinned Boolean @default(false) @map("is_pinned")
  isLocked Boolean @default(false) @map("is_locked")

  lockSetById String? @map("lock_set_by_id")
  lockSetBy User? @relation("PostLocks", fields: [lockSetById], references: [id], onDelete: SetNull)

  // Denormalized vote tallies. The votes table stays the source of truth; these
  // are maintained transactionally alongside every vote write so feed queries
  // never have to aggregate.
  upvoteCount   Int @default(0) @map("upvote_count")
  downvoteCount Int @default(0) @map("downvote_count")
  score         Int @default(0)

  // Maintained by the ranking worker. Persisted so the SQL feed fallback ranks
  // identically to the Redis ZSETs instead of approximating with raw counts.
  hotScore           Float @default(0) @map("hot_score")
  controversialScore Float @default(0) @map("controversial_score")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  communityId String?    @map("community_id")
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  comments Comment[]
  votes    Vote[]
  savedBy  SavedPost[]
  reports  Report[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([communityId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([deletedAt, createdAt(sort: Desc)])
  @@index([deletedAt, score(sort: Desc)])
  @@index([deletedAt, hotScore(sort: Desc)])
  @@index([deletedAt, controversialScore(sort: Desc)])
  @@map("posts")
}

model Comment {
  id      String @id @default(uuid())
  content String

  isEdited Boolean @default(false) @map("is_edited")
  isLocked Boolean @default(false) @map("is_locked")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  savedBy SavedComment[]
  reports CommentReport[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([postId, createdAt(sort: Desc)])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

model Vote {
  id   String   @id @default(uuid())
  type VoteType

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, postId])
  @@index([postId, type])
  @@map("votes")
}

model Follow {
  followerId String @map("follower_id")
  follower   User   @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String @map("following_id")
  following   User   @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Block {
  blockerId String @map("blocker_id")
  blocker   User   @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String @map("blocked_id")
  blocked   User   @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model SavedPost {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, postId])
  @@index([postId])
  @@map("saved_posts")
}

model SavedComment {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String  @map("comment_id")
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, commentId])
  @@index([commentId])
  @@map("saved_comments")
}

model Report {
  id String @id @default(uuid())

  reporterId String @map("reporter_id")
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reason String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@index([reporterId])
  @@map("reports")
}

model CommentReport {
  id String @id @default(uuid())

  reporterId String @map("reporter_id")
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  commentId String  @map("comment_id")
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reason String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([commentId])
  @@index([reporterId])
  @@map("comment_reports")
}

model Notification {
  id String @id @default(uuid())

  recipientId String @map("recipient_id")
  recipient   User   @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  senderId String? @map("sender_id")
  sender   User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  type    NotificationType
  title   String
  content String
  link    String?

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}
