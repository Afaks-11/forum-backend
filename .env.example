# Copy to `.env` and fill in real values. Every variable below is required:
# src/config/env.config.ts validates them at startup and throws on any that are
# missing, so the process fails fast rather than misbehaving later.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated allowlist for CORS (Express and Socket.IO share this list).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://forum:forum_password@localhost:5432/forum?schema=public
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Use two different high-entropy secrets, e.g. `openssl rand -base64 48`.
# The refresh secret is combined with the user's password hash when signing, so
# changing a password invalidates that user's outstanding refresh tokens.
JWT_ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
JWT_REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string

# ---------------------------------------------------------------------------
# Media uploads (Cloudinary signed direct uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# Queue dashboard (/admin/queues, HTTP basic auth)
# ---------------------------------------------------------------------------
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=replace_with_a_strong_password

# ---------------------------------------------------------------------------
# Outbound email (SMTP)
# ---------------------------------------------------------------------------
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=Forum Platform <you@example.com>
